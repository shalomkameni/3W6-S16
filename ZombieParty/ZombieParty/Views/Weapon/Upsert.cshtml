@model ZombieParty.Models.Weapon

@{
    ViewData["Title"] = "Create";
}

<h4>Weapon</h4>
<hr />
<div class="row">
    <div class="col-md-4 bg-white shadow">
        <form asp-action="Upsert">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control summernote"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Force" class="control-label"></label>
                <input asp-for="Force" class="form-control" />
                <span asp-validation-for="Force" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Resistance" class="control-label"></label>
                <input asp-for="Resistance" class="form-control" />
                <span asp-validation-for="Resistance" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Lifespan" class="control-label"></label>
                <input asp-for="Lifespan" class="form-control" />
                <span asp-validation-for="Lifespan" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CreatedDate" class="control-label"></label>
                <input asp-for="CreatedDate" class="form-control" />
                <span asp-validation-for="CreatedDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UpdatedDate" class="control-label"></label>
                <input asp-for="UpdatedDate" class="form-control" />
                <span asp-validation-for="UpdatedDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Image" class="control-label"></label>
                <input asp-for="Image" class="form-control" />
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Qty" class="control-label"></label>
                <input asp-for="Qty" class="form-control" />
                <span asp-validation-for="Qty" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="QtyBought" class="control-label"></label>
                <input asp-for="QtyBought" class="form-control" />
                <span asp-validation-for="QtyBought" class="text-danger"></span>
            </div>
            <div class="form-group">
                <hr />
                <partial name="_UpsertButton" model="@Model?.Id ?? 0" />
            </div>
        </form>

        <br />
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $('.summernote').summernote();
        });
    </script>
}
