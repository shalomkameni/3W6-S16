@model ZombieParty.Models.ZombieType
<form method="post" asp-action="Upsert">
    <div class="border p-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group row">
            <h2 class="text-info pl-3">Zombie Type</h2>
            <hr />
        </div>
        <input type="hidden" asp-for="Id" />

        <div class="row">
            <div class="col-8">
                <div class="form-group row mt-2">
                    <div class="col-2">
                        <label asp-for="TypeName"></label>
                    </div>
                    <div class="col-8">
                        <input asp-for="TypeName" class="form-control" />
                        <span asp-validation-for="TypeName" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row mt-2">
                    <div class="col-2">
                        <label asp-for="Point"></label>
                    </div>
                    <div class="col-8">
                        <input asp-for="Point" class="form-control" />
                        <span asp-validation-for="Point" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row mt-2">


                    <div class="col-8 offset-2">
                        <partial name="_UpsertButton" model="@Model?.Id ?? 0" />

                    </div>
                </div>

            </div>
            <div class="col-4">
            </div>
        </div>
    </div>
</form>
@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
