<div class="container p-3">
    <div class="row pt-4">
        <div class="col-11">
            <h2 class="text-primary">Zombie Type</h2>
        </div>

    </div>

    <br /><br />
    <table class="table table-bordered table-striped" style="width:100%">
        <thead class="bg-dark text-white">
            <tr>
                <th class="align-middle">
                    Type Name
                </th>
                <th class="text-center">
                    <a asp-controller="ZombieType" asp-action="Upsert" class="btn btn-success">
                        <i class="fas fa-plus-square"></i> &nbsp; Ajouter
                    </a>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (ZombieType item in this.ViewBag.MaListe)
            {
                <tr>
                    <td width="80%">
                        <a class="btn btn-info" asp-action="Details" asp-route-id="@item.Id">
                            @item.TypeName
                        </a>
                    </td>
                    <td class="text-center">
                        <a class="btn btn-secondary" asp-action="upsert" asp-route-zombieTypeId="@item.Id">
                            <i class="fas fa-pencil"></i>
                        </a>

                        <a class="btn btn-danger">
                            <i class="fas fa-trash-alt"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
