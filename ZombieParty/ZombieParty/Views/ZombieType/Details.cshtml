@model ZombieTypeVM

@{
    ViewData["Title"] = "Details";
}


<h1>Type: @Model.ZombieType</h1>


<div class="row">
    @foreach (var item in Model.Zombies)
    {
        <partial name="_Zombie_Card" model="item" />
    }
</div>
@if (Model.Zombies.Count == 0)
{
    <div class="alert alert-danger">No associated zombie for this type</div>
}

<div>
    <a asp-action="Index" class="btn btn-success"><i class="fas fa-long-arrow-left"></i>&nbsp;Back to List</a>
</div>
